# Aegis kernel configuration.
#
# Consumed by `kconf` (github.com/LoricaOS/kconfig): resolves a .config and
# generates build/generated/autoconf.h (#define CONFIG_*) + build/auto.conf
# (Make vars). Pick a tier with `make <name>_defconfig` (see configs/).
#
# INVARIANT: the security core has NO config symbol. cap/, the syscall-boundary
# cap_check, and uaccess are the product and are always compiled in — there is
# deliberately no knob to remove them. Minification only ever exposes knobs for
# genuinely optional code.

mainmenu "Aegis kernel configuration"

config MMU
	bool "Paging-based memory model (MMU)"
	default y
	help
	  The virtual-memory model: page tables, per-process address spaces,
	  demand paging, fork COW, and copy_to/from_user backed by a page-fault
	  exception table.

	  Say N only for MCU-class targets with no MMU (e.g. RP2350 / Pico 2),
	  which select a flat, MPU-isolated memory model instead. That backend
	  is a FUTURE port and is not yet present, so N does not build today —
	  the symbol exists so the no-MMU world is a first-class config axis
	  rather than a fork.

	  Security note: N trades away hardware memory isolation (a memory bug
	  can cross process boundaries). Capability *authority* is unaffected —
	  cap_check does not depend on the MMU — but defence-in-depth weakens.
	  This is why N is expert-only.

menu "Networking"

config NET
	bool "Networking stack (IPv4 / TCP / UDP / sockets)"
	default y
	help
	  The in-kernel protocol stack: netdev layer, Ethernet, IPv4, TCP, UDP,
	  the BSD socket API and AF_UNIX sockets. Disabling removes the stack,
	  the socket syscalls, and every NIC driver (they are useless without
	  it), reclaiming both code and the static socket buffers.

	  Required by the "workstation" tier. Off in "tiny".

endmenu

menu "Filesystems"

config FS_EXT2
	bool "ext2 disk filesystem"
	default y
	help
	  The ext2 filesystem — the historical root/disk backend, with full Unix
	  ownership + permissions (DAC). It is reached through the fs_ops vtable,
	  so turning it off substitutes a "nullfs" backend: the VFS then serves
	  only initrd (read-only) and tmpfs, and any disk path fails. Off is for a
	  no-disk embedded config (or, later, one that mounts FAT on removable
	  media instead). ~34 KB of code.

config FS_FAT
	bool "FAT32 disk filesystem"
	depends on !FS_EXT2
	default n
	help
	  A read-write FAT32 backend — small (~a third of ext2's code) and the
	  on-disk format every SD card and PC already speaks, so a handheld's storage
	  is readable on any machine. Selectable only when ext2 is off: both provide
	  the root disk backend, and exactly one is linked. Supports create/read/
	  write/unlink/truncate, mkdir/rmdir, rename, and long filenames (VFAT LFN,
	  read + generated). No Unix ownership/permissions (FAT has none) — authority
	  comes from the capability layer at the syscall boundary.

endmenu

menu "Device drivers"

config PCI
	bool "PCI/PCIe bus"
	default y
	help
	  PCIe ECAM enumeration (from the ACPI MCFG table) and config-space access
	  — the bus almost every emulated and real machine puts its devices on
	  (NVMe, AHCI, xHCI, HD-audio, PCI NICs, and virtio-pci). Turn it OFF for a
	  microVM target that speaks only virtio-mmio (Firecracker, QEMU microvm):
	  the enumeration + ECAM path is replaced by a stub, and virtio devices are
	  found over mmio instead (CONFIG_VIRTIO_MMIO). Every PCI-only device below
	  depends on this, so they turn off with it.

config HYPERV
	bool "Hyper-V guest support (VMBus + synthetic devices)"
	default y
	help
	  Microsoft Hyper-V paravirtual guest support: the VMBus transport and
	  the synthetic SCSI (storvsc), NIC (netvsc), keyboard, mouse, and the
	  time-sync / heartbeat / shutdown / KVP integration components. Only
	  useful when running as a Hyper-V / Azure guest; pure ballast anywhere
	  else. The synthetic NIC (netvsc) additionally needs CONFIG_NET.

config AUDIO_HDA
	bool "Intel HD Audio"
	depends on PCI
	default y
	help
	  The Intel HDA controller driver. A text-only or headless build has no
	  use for it.

config FB
	bool "Framebuffer console"
	default y
	help
	  The linear-framebuffer text console and compositor hooks (~80 KB of
	  code). A headless / serial-only build has no use for it — printk falls
	  back to serial/VGA, and the boot splash and panic screen go with it.

config NVME
	bool "NVMe block device"
	depends on PCI
	default y

config AHCI
	bool "AHCI / SATA block device"
	depends on PCI
	default y

config USB
	bool "USB host (xHCI) + HID"
	depends on PCI
	default y
	help
	  The xHCI USB host controller and USB HID (keyboard/mouse). A device with
	  no USB, or a non-USB keyboard, wants none of it.

config VMWARE
	bool "VMware PVSCSI"
	depends on PCI
	default y
	help
	  VMware's paravirtual SCSI HBA. Only useful under ESXi/Workstation.
	  (The vmxnet3 NIC is gated by CONFIG_NET.)

config PVPANIC
	bool "pvpanic guest->host panic notifier"
	default y

comment "VirtIO devices"

config VIRTIO
	bool "VirtIO paravirtual device support"
	default y
	help
	  The virtio transport (virtio-pci + virtqueue) shared by all the
	  paravirtual devices below. Turning this off removes the transport and,
	  by dependency, every virtio device — a bare-metal build with no virtio
	  hardware wants none of it. Each device is an independent knob so you can
	  keep, say, virtio-blk while dropping virtio-gpu.

config VIRTIO_MMIO
	bool "virtio-mmio transport (microVM)"
	depends on VIRTIO
	default n
	help
	  Discover virtio devices as flat MMIO register blocks at fixed physical
	  addresses (spec §4.2) instead of on a PCI bus — the transport microVMs
	  use (Firecracker, QEMU `-machine microvm`). Probes the standard transport
	  window (0xfeb00000, 8 slots); each virtio device driver then works over
	  either transport unchanged. Enable for a microVM target (typically with
	  CONFIG_PCI off); harmless alongside PCI otherwise.

config VIRTIO_BLK
	bool "virtio-blk (block device)"
	depends on VIRTIO
	default y

config VIRTIO_SCSI
	bool "virtio-scsi (SCSI HBA)"
	depends on VIRTIO
	default y

config VIRTIO_GPU
	bool "virtio-gpu (2D scanout)"
	depends on VIRTIO
	default y
	help
	  The virtio-gpu 2D scanout device. A headless / text build has no use
	  for it; the framebuffer screenshot path degrades gracefully without it.

config VIRTIO_INPUT
	bool "virtio-input (keyboard/tablet)"
	depends on VIRTIO
	default y

config VIRTIO_RNG
	bool "virtio-rng (entropy)"
	depends on VIRTIO
	default y

config VIRTIO_BALLOON
	bool "virtio-balloon (memory ballooning)"
	depends on VIRTIO
	default y

config VIRTIO_PMEM
	bool "virtio-pmem (persistent memory)"
	depends on VIRTIO
	default y

config VIRTIO_CONSOLE
	bool "virtio-console"
	depends on VIRTIO
	default y

config VIRTIO_9P
	bool "virtio-9p (host filesystem share)"
	depends on VIRTIO
	default y

config VIRTIO_NET
	bool "virtio-net (NIC)"
	depends on VIRTIO && NET
	default y

config VIRTIO_VSOCK
	bool "virtio-vsock (host<->guest sockets)"
	depends on VIRTIO && NET
	default y

endmenu

menu "Kernel diagnostics"

config TRACE
	bool "Lockless flight-recorder trace ring"
	default y
	help
	  A fixed 16384-entry ring (~640 KB of static BSS) appended locklessly
	  from any context and dumped on demand (SysRq, /proc/trace, panic). A
	  race-hunting instrument — invaluable while developing, dead weight on a
	  constrained target. When off, trace_emit()/trace_dump() become no-ops
	  and the ring is reclaimed.

config CC_OPTIMIZE_FOR_SIZE
	bool "Optimize for size (-Os)"
	default n
	help
	  Compile with -Os instead of -O2: the compiler favours smaller code over
	  speed. Typically trims a further chunk of .text on top of --gc-sections
	  (which is always on), at some runtime cost. Want it on for a constrained
	  target (nano/pico2), off for a performance build.

config KERNEL_TESTS
	bool "In-tree boot self-tests"
	default y
	help
	  Compile the self-tests that run during boot (e.g. the VFS poll test).
	  Off for a lean production / embedded build.

endmenu

menu "Static sizing (RAM footprint)"

config RAMFS_MAX_INODES
	int "tmpfs: max inodes per instance"
	default 256
	help
	  Maximum files+dirs in each tmpfs (/tmp, /run). Every instance
	  statically embeds inodes[] and, per inode, a pages-per-file pointer
	  array — so this multiplied by RAMFS_PAGES_PER_FILE dominates the tmpfs
	  BSS (256 x 256 x 8 B = 512 KB per instance at the defaults). Shrink both
	  hard for a constrained target.

config RAMFS_MAX_DENTS
	int "tmpfs: max directory entries per instance"
	default 256

config RAMFS_PAGES_PER_FILE
	int "tmpfs: max pages per file (x 4 KiB)"
	default 256

config MAX_CPUS
	int "Maximum supported CPUs"
	default 1024
	help
	  Sizes the per-CPU statics — TSS, GDT, and per-CPU areas — at roughly
	  200 B x this value, so the default 1024 costs ~250 KB of BSS. A single-
	  or dual-core target wants a handful (the SMP bring-up caps here too).

config PTY_MAX_PAIRS
	int "Max pseudo-terminal pairs"
	default 16
	help
	  Each pair statically reserves two PTY_BUF_SIZE ring buffers (~8.7 KB),
	  so 16 pairs is ~140 KB. A headless target with one console wants a few.

config KLOG_SIZE_KB
	int "Kernel log ring size (KB)"
	default 64

config EXT2_CACHE_SLOTS
	int "ext2 block-cache slots"
	default 16

config PMM_BOOT_GB
	int "Physical memory the boot bitmap covers (GB)"
	default 4
	help
	  The early physical-page bitmap is sized to this many GB (1 GB -> 32 KB
	  of BSS). Set it to the target's actual RAM; on an MCU with sub-GB SRAM
	  the bitmap becomes negligible.

endmenu
