# tiny — smallest bootable kernel: boots to the "no init found" smoke panic.
# The minification floor; the security core is present (it has no knob), but
# everything optional is off.
CONFIG_MMU=y
# CONFIG_NET is not set
# CONFIG_AUDIO_HDA is not set
# CONFIG_HYPERV is not set
# CONFIG_TRACE is not set
# CONFIG_VIRTIO is not set
# shrink the tmpfs arenas hard: 32 x 32 pages = ~14 KB/instance vs ~556 KB
CONFIG_RAMFS_MAX_INODES=32
CONFIG_RAMFS_MAX_DENTS=32
CONFIG_RAMFS_PAGES_PER_FILE=32
# shrink the remaining static arenas (per-CPU, PTY, klog, ext2 cache, PMM bitmap)
CONFIG_MAX_CPUS=8
CONFIG_PTY_MAX_PAIRS=4
CONFIG_KLOG_SIZE_KB=8
CONFIG_EXT2_CACHE_SLOTS=4
CONFIG_PMM_BOOT_GB=2
